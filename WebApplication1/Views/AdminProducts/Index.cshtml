@model IEnumerable<WebApplication1.Models.Product>

@{
    ViewData["Title"] = "Products";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-products-index.css" />
}


<div class="container-fluid">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Products</h2>

        <div>
        <!--EVENTS-->
            <a asp-controller="AdminProducts"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Add Product

            </a>

            <a asp-controller="AdminProducts"
               asp-action="Import"
               class="btn btn-success">

                <i class="bi bi-upload"></i>
                Import CSV

            </a>

            <a asp-controller="AdminProducts"
               asp-action="Export"
               class="btn btn-secondary">

                <i class="bi bi-download"></i>
                Export CSV

            </a>

        </div>

    </div>


    <!-- =====================================================
         BULK DELETE FORM
         IMPORTANT:
         This form is NOT around the table.
         ===================================================== -->

    <form asp-controller="AdminProducts"
          asp-action="DeleteSelected"
          method="post"
          id="bulkDeleteForm">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="mb-0">
                Product List
            </h5>

            <button type="submit"
                    class="btn btn-danger"
                    id="deleteSelectedButton"
                    disabled
                    onclick="return confirm('Are you sure you want to delete the selected products?');">

                <i class="bi bi-trash"></i>
                Delete Selected

            </button>

        </div>

    </form>


    <!-- =====================================================
         PRODUCT TABLE
         ===================================================== -->

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead>

                        <tr>

                            <!-- SELECT ALL -->

                            <th class="product-select-column">

                                <input type="checkbox"
                                       id="selectAll"
                                       class="product-checkbox" />

                            </th>

                            <th>ID</th>

                            <th>Product Name</th>

                            <th>Description</th>

                            <th>Price</th>

                            <th>Stock</th>

                            <th>Category ID</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var product in Model)
                        {
                            <tr>

                                <!-- PRODUCT CHECKBOX -->

                                <td class="product-select-cell">

                                    <input type="checkbox"
                                           name="productIds"
                                           value="@product.ProductID"
                                           class="product-checkbox"
                                           form="bulkDeleteForm" />

                                </td>


                                <td>
                                    @product.ProductID
                                </td>


                                <td>
                                    @product.ProductName
                                </td>


                                <td>
                                    @product.Description
                                </td>


                                <td>
                                    ₹@product.Price
                                </td>


                                <td>
                                    @product.Stock
                                </td>


                                <td>
                                    @product.CategoryID
                                </td>


                                <td>

                                    <!-- EDIT -->

                                    <a asp-action="Edit"
                                       asp-route-id="@product.ProductID"
                                       class="btn btn-sm btn-warning">

                                        <i class="bi bi-pencil"></i>
                                        Edit

                                    </a>


                                    <!-- INDIVIDUAL DELETE FORM -->

                                    <form asp-action="Delete"
                                          asp-route-id="@product.ProductID"
                                          method="post"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to delete this product?');">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/admin-products-index.js"></script>

}