@model WebApplication1.Models.Category

@{
    ViewData["Title"] = "Edit Category";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2>Edit Category</h2>
        <p class="text-muted">
            Update category information
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="AdminCategories"
                  asp-action="Edit"
                  asp-route-id="@Model.CategoryID"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="CategoryID" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="CategoryName"
                           class="form-label">
                        Category Name
                    </label>

                    <input asp-for="CategoryName"
                           class="form-control" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-dark">

                        <i class="bi bi-check-lg me-1"></i>
                        Save Changes

                    </button>

                    <a asp-controller="AdminCategories"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>